// bech32_core — the BCH checksum of BIP 173 and BIP 350, as a state
// machine that allocates nothing, holds no buffer, and builds for a
// microcontroller.
//
// The package has a second module because `bech32` speaks `Str`,
// `Bytes` and `Cursor`, and the embedded runtime defines none of them.
// A device that called one would fail at the linker rather than at the
// type checker.  The half a device uses is therefore its own module,
// and it takes and returns integers.
//
// The state is one integer.  `chk` is the running polymod, thirty bits
// of it, and nothing else.  The caller feeds five bits at a time, in
// the order BIP 173 § "Checksum" gives:
//
//   var c = bech32_core.start()
//   for each byte of the hrp:  c = feed(c, hrp_high(byte))
//   c = feed(c, 0)
//   for each byte of the hrp:  c = feed(c, hrp_low(byte))
//   for each data value:       c = feed(c, value)
//
// and then calls `finish` to produce a checksum or `verify` to check
// one.  The loop has the same shape as the specification's, so the
// port can be read against it line by line.
//
// The human-readable part goes in twice: the high three bits of every
// character, a zero, then the low five bits.  BIP 173 calls this
// `hrp_expand`.  It makes the checksum depend on the case of the
// prefix, which is what BIP 173's invalid vector `A1G7SGD8` tests.
//
// bech32 and bech32m differ in one constant, 1 against 0x2bc830a3
// (BIP 350 § "Specification").  Which one an address uses is decided by
// its witness version, and `bechsegwit.variant_for` is that rule.
//
// Every function here carries `@tier(embedded)`, so a `Str`, a list
// literal or an unbounded loop written below is refused where it is
// written.

// The running checksum: thirty bits of polymod and nothing else.
//
// A `@value` struct, so it lives in the caller's stack frame with no
// header, no reference count and no allocation.
pub @value
struct BechChk
    chk: Int

// bech32's variant code: 0.
//
// An integer rather than the enum `bech32` declares, because a `@value`
// module holds integers and a fieldless enum is still a tagged value.
// `bech32.variant_code` is the one function that converts between them.
pub @tier(embedded)
fn variant_bech32() -> Int
    0

// bech32m's variant code: 1.
pub @tier(embedded)
fn variant_bech32m() -> Int
    1

// The constant a finished polymod is compared against, or XORed with:
// 1 for bech32, 0x2bc830a3 for bech32m.  Any other code answers 1.
//
// This constant is the whole of the difference between the two
// encodings.
//
// ```novo
// use bech32_core
//
// fn main() [io]
//     println("${bech32_core.variant_const(bech32_core.variant_bech32())}")   // 1
// ```
pub @tier(embedded)
fn variant_const(variant: Int) -> Int
    if variant == 1
        return 0x2bc830a3
    1

// Which variant a finished residue names, or -1 for neither.
//
// A decoder feeds everything, the six checksum characters included,
// and asks the residue which encoding the string used.  A caller that
// expected one and got the other has an address whose witness version
// and encoding disagree, which BIP 350 makes detectable.
pub @tier(embedded)
fn variant_of(residue: Int) -> Int
    if residue == 1
        return 0
    if residue == 0x2bc830a3
        return 1
    -1

// How many characters the checksum occupies: 6.
pub @tier(embedded)
fn checksum_len() -> Int
    6

// The longest bech32 string BIP 173 allows: 90 characters.
//
// The BCH code guarantees detection of up to four errors only within
// this length.  It is a limit on the whole string, prefix, separator
// and checksum included, and not on the data part alone.
//
// Some uses lift it deliberately.  BOLT 11 lightning invoices are
// bech32 and are routinely longer.  `bech32.encode` and `bech32.decode`
// enforce the limit, and `bech32.encode_unlimited` and
// `bech32.decode_unlimited` do not.
pub @tier(embedded)
fn max_length() -> Int
    90

// The character that separates the human-readable part from the data:
// `1`, which is ASCII 49.
//
// `1` is not in the data charset, so a decoder finds the boundary by
// scanning for the last one.  A prefix may itself contain `1`, and BIP
// 173's `an83characterlonghumanreadablepart…number1and…` vector tests a
// decoder that scanned for the first.
pub @tier(embedded)
fn separator() -> Int
    '1'

// The ASCII byte that encodes the five-bit value `v`.
//
// The charset is `qpzry9x8gf2tvdw0s3jn54khce6mua7l`, lower case.  A `v`
// outside `0 ..= 31` answers 0, which is not a character in the charset
// and so cannot be mistaken for one.
//
// The order is chosen so that the characters most often confused when
// read or transcribed are placed where a single-character error is
// most likely to be caught (BIP 173 § "Rationale").
//
// ```novo
// use bech32_core
//
// fn main() [io]
//     println("${bech32_core.charset_at(0)}")   // 113, which is `q`
// ```
pub @tier(embedded)
fn charset_at(v: Int) -> Int
    match v
        0  => 'q'
        1  => 'p'
        2  => 'z'
        3  => 'r'
        4  => 'y'
        5  => '9'
        6  => 'x'
        7  => '8'
        8  => 'g'
        9  => 'f'
        10 => '2'
        11 => 't'
        12 => 'v'
        13 => 'd'
        14 => 'w'
        15 => '0'
        16 => 's'
        17 => '3'
        18 => 'j'
        19 => 'n'
        20 => '5'
        21 => '4'
        22 => 'k'
        23 => 'h'
        24 => 'c'
        25 => 'e'
        26 => '6'
        27 => 'm'
        28 => 'u'
        29 => 'a'
        30 => '7'
        31 => 'l'
        _  => 0

// The five-bit value the ASCII byte `ch` encodes, or -1 for a byte that
// is not in the charset.
//
// Case-insensitive: `Q` and `q` are both 0.  The mixed-case refusal is
// a rule about the whole string and lives in `bech32`, because a
// per-character decoder cannot know what case the rest of the string
// was in.
//
// `1`, `b`, `i` and `o` are absent from the charset, so each of them
// answers -1.
pub @tier(embedded)
fn charset_index(ch: Int) -> Int
    var c = ch
    if c >= 'A' and c <= 'Z'
        c = c + 32
    match c
        113 => 0
        112 => 1
        122 => 2
        114 => 3
        121 => 4
        57  => 5
        120 => 6
        56  => 7
        103 => 8
        102 => 9
        50  => 10
        116 => 11
        118 => 12
        100 => 13
        119 => 14
        48  => 15
        115 => 16
        51  => 17
        106 => 18
        110 => 19
        53  => 20
        52  => 21
        107 => 22
        104 => 23
        99  => 24
        101 => 25
        54  => 26
        109 => 27
        117 => 28
        97  => 29
        55  => 30
        108 => 31
        _   => -1

// The three high bits of a human-readable character, as the checksum
// takes them: `ch >> 5`.
pub @tier(embedded)
fn hrp_high(ch: Int) -> Int
    (ch >> 5) & 7

// The five low bits of a human-readable character: `ch & 31`.
pub @tier(embedded)
fn hrp_low(ch: Int) -> Int
    ch & 31

// A fresh checksum, with nothing fed in: `chk` is 1.
pub @tier(embedded)
fn start() -> BechChk
    BechChk { chk: 1 }

// One step of the BCH polymod over the five-bit value `v`.
//
// The top five bits are shifted out, `v` is mixed in, and one of the
// five generator constants is XORed in for each top bit that was set.
// That is the inner loop of BIP 173's `bech32_polymod`.
//
// A `v` outside `0 ..= 31` is masked to its low five bits.
//
// ```novo
// use bech32_core
//
// fn main() [io]
//     println("${bech32_core.feed(bech32_core.start(), 0).chk}")   // 32
// ```
pub @tier(embedded)
fn feed(c: BechChk, v: Int) -> BechChk
    let top = c.chk >> 25
    var chk = ((c.chk & 0x1ffffff) << 5) ^ (v & 31)
    if (top & 1) != 0
        chk = chk ^ 0x3b6a57b2
    if (top & 2) != 0
        chk = chk ^ 0x26508e6d
    if (top & 4) != 0
        chk = chk ^ 0x1ea119fa
    if (top & 8) != 0
        chk = chk ^ 0x3d4233dd
    if (top & 16) != 0
        chk = chk ^ 0x2a1462b3
    BechChk { chk: chk }

// Close the checksum for `variant`: feed six zeros and XOR the
// variant's constant.
//
// The `chk` of the result holds the six five-bit checksum values packed
// highest first, and `checksum_value` reads them out.  An encoder calls
// this.  A decoder calls `verify` instead, because the six characters
// are already in the string it is feeding.
pub @tier(embedded)
fn finish(c: BechChk, variant: Int) -> BechChk
    var d = c
    for _i in 0..6
        d = feed(d, 0)
    BechChk { chk: d.chk ^ variant_const(variant) }

// The `i`-th of the six checksum values from a finished state,
// `0 ..= 5`, highest first.
//
// `charset_at` of each is the character to write.  An `i` outside the
// range answers 0.
pub @tier(embedded)
fn checksum_value(c: BechChk, i: Int) -> Int
    if i < 0 or i > 5
        return 0
    (c.chk >> (5 * (5 - i))) & 31

// The running polymod, for a caller that wants to ask `variant_of`.
pub @tier(embedded)
fn residue(c: BechChk) -> Int
    c.chk

// True when everything fed in, the expanded prefix, the data and the
// six checksum values, leaves `variant`'s residue.
//
// The decode-side mirror of `finish`.  Both directions run the same
// `feed` loop over the same values and differ only in the last step.
pub @tier(embedded)
fn verify(c: BechChk, variant: Int) -> Bool
    c.chk == variant_const(variant)
