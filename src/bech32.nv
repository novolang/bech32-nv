// bech32 — BIP 173 and BIP 350 over text and bytes the caller already
// holds.
//
// `bech32_core` is the checksum and `bechbits` is the regrouping.  This
// module is those two with a `Str` source and a destination attached,
// plus the three rules that concern the whole string and that a
// per-character machine cannot see: the mixed-case refusal, the
// 90-character limit, and where the separator is.
//
// `decode_into` writes into a `Cursor` the caller sized with
// `decoded_len` and answers the human-readable part as a range into the
// string the caller already has.  A device verifying an address it is
// about to display then needs no second copy of the string.
//
// The separator is the last `1` in the string.  A human-readable part
// may contain `1`, and `1` is not in the data charset, so scanning from
// the right is unambiguous.

use std.bytes
use std.str
use bech32_core
use bechbits

// Which of the two encodings a string uses.
//
// They differ in one constant and in nothing else.  Which one an
// address should use is decided by its witness version rather than by
// its prefix, and `bechsegwit.variant_for` is that rule.
pub enum BechVariant
    // BIP 173's original, checksum constant 1.  Segwit version 0, and
    // every non-segwit use that predates BIP 350, BOLT 11 invoices
    // among them.
    Bech32
    // BIP 350's revision, checksum constant 0x2bc830a3.  Segwit
    // versions 1 and above, which includes every taproot address.
    Bech32m

// What went wrong reading a bech32 string, or writing one.
//
// The variants carry the `Bech` prefix because a variant is constructed
// by name across the whole program, and `MixedCase` and `BadChecksum`
// are names every codec wants.
pub enum BechError
    // Upper-case and lower-case characters in the same string.
    //
    // `at` is the offset of the first character whose case disagrees
    // with the first cased character in the string.  Either case alone
    // is accepted and means the same thing, since an address may be
    // printed in upper case for a QR code.  A mixture is refused (BIP
    // 173 § "Bech32").
    BechMixedCase(at: Int)
    // No `1` anywhere in the string.
    BechNoSeparator
    // The separator is at offset 0, so the human-readable part is
    // empty.  BIP 173 requires at least one character.
    BechHrpEmpty
    // The human-readable part is longer than 83 characters, which is
    // the most the 90-character limit leaves room for.
    BechHrpTooLong(len: Int)
    // A character of the human-readable part outside `33 ..= 126`.
    //
    // `at` is the offset and `ch` is the byte.
    BechHrpBadCharacter(at: Int, ch: Int)
    // Fewer than six characters after the separator, so there is not
    // even a checksum.
    BechDataTooShort(len: Int)
    // A character of the data part that is not in the charset.
    //
    // `at` is the offset and `ch` is the byte.  `1`, `b`, `i` and `o`
    // are the four alphanumerics absent from the charset.
    BechBadCharacter(at: Int, ch: Int)
    // The checksum does not match either variant's constant.
    //
    // `residue` is what the polymod came to.  It is never 1 or
    // 0x2bc830a3, because those two are valid under one variant.
    BechBadChecksum(residue: Int)
    // The checksum is valid for the other variant.
    //
    // A refusal of its own rather than a bad checksum: a valid bech32m
    // string handed to a bech32 reader is usually a taproot address in
    // an application that predates BIP 350.
    BechWrongVariant(found: Int, wanted: Int)
    // The string is longer than the 90 characters BIP 173 allows.
    //
    // `encode_unlimited` and `decode_unlimited` do not enforce the
    // limit.
    BechTooLong(len: Int)
    // A data value outside `0 ..= 31` was handed to `encode`.
    BechValueOutOfRange(at: Int, v: Int)
    // The tail of a five-to-eight conversion had bits set, or was five
    // bits or longer.
    //
    // BIP 173 requires the padding to be fewer than five bits and all
    // zero.  Accepting either would let two different strings decode to
    // the same bytes.
    BechBadPadding
    // The destination handed to `encode_into` or `decode_into` was
    // shorter than the answer.  `need` is what `encoded_len` or
    // `decoded_len` would have said.
    BechBufferTooSmall(need: Int, have: Int)
    // A segwit address whose data part is empty, so it has no witness
    // version.  BIP 173's invalid vector `bc1gmk9yu`.
    BechNoWitnessVersion
    // A witness version outside `0 ..= 16`.
    BechBadVersion(version: Int)
    // A witness program whose length the version does not allow.
    //
    // Version 0 takes exactly 20 or 32 bytes (BIP 141), and versions 1
    // to 16 take 2 to 40.
    BechBadProgramLength(version: Int, len: Int)
    // A segwit address whose prefix is not the one the caller asked
    // for.  Both are lower case.
    BechWrongHrp(found: Str, wanted: Str)

// What a decode found, without copying anything it did not have to.
//
// `hrp_start` and `hrp_end` are a half-open byte range into the string
// that was decoded, so the caller reads the human-readable part out of
// the bytes it already holds.  `values` is how many five-bit values
// were written into the destination, and `variant` is the code
// `bech32_core.variant_of` answered.
//
// A boxed struct rather than a `@value` one because it is a `Result`
// payload, and a `@value` struct may not be.
pub struct BechRead
    hrp_start: Int
    hrp_end: Int
    values: Int
    variant: Int

// A whole decoded string, for a caller that does not mind allocating.
//
// The human-readable part is its own lower-case `Str` and the data its
// own list of five-bit values, the checksum not included.
pub struct BechData
    hrp: Str
    data: [u8]
    variant: BechVariant

// The standard `Error` implementation, so a bad string can be reported
// by anything that reports errors.
impl Error for BechError
    // Answer the one-line report: what was wrong, and at what character
    // offset when there is one.
    @tier(app)
    fn message(self) -> Str
        match self
            BechMixedCase(at)                  => "bech32: upper and lower case mixed, at offset ${at}"
            BechNoSeparator                    => "bech32: no separator `1` in the string"
            BechHrpEmpty                       => "bech32: the human-readable part is empty"
            BechHrpTooLong(len)                => "bech32: the human-readable part is ${len} characters, more than 83"
            BechHrpBadCharacter(at, ch)        => "bech32: byte ${ch} at offset ${at} is not allowed in the human-readable part"
            BechDataTooShort(len)              => "bech32: ${len} characters after the separator, fewer than the 6 of a checksum"
            BechBadCharacter(at, ch)           => "bech32: byte ${ch} at offset ${at} is not in the charset"
            BechBadChecksum(residue)           => "bech32: bad checksum (residue ${residue})"
            BechWrongVariant(found, wanted)    =>
                "bech32: the checksum is ${variant_name(found)}, expected ${variant_name(wanted)}"
            BechTooLong(len)                   => "bech32: the string is ${len} characters, more than 90"
            BechValueOutOfRange(at, v)         => "bech32: data value ${v} at index ${at} is not a five-bit value"
            BechBadPadding                     => "bech32: the padding bits are set or longer than four bits"
            BechBufferTooSmall(need, have)     => "bech32: the destination has room for ${have}, and ${need} are needed"
            BechNoWitnessVersion               => "bech32: the data part is empty, so there is no witness version"
            BechBadVersion(version)            => "bech32: witness version ${version} is outside 0 to 16"
            BechBadProgramLength(version, len) =>
                "bech32: a ${len}-byte witness program is not allowed at version ${version}"
            BechWrongHrp(found, wanted)        => "bech32: the prefix is `${found}`, expected `${wanted}`"

fn variant_name(code: Int) -> Str
    if code == bech32_core.variant_bech32m()
        return "bech32m"
    "bech32"

// The variant as the integer `bech32_core` stores.
//
// The enum is what a host caller reads, and the integer is what a
// `@value` state on a device holds.
//
// ```novo
// use bech32
// use bech32_core
//
// fn main() [io]
//     println("${bech32.variant_code(Bech32)}")   // 0
// ```
pub fn variant_code(v: BechVariant) -> Int
    match v
        Bech32  => bech32_core.variant_bech32()
        Bech32m => bech32_core.variant_bech32m()

// The integer as the enum.  A code that is neither answers `Bech32`.
pub fn variant_from_code(code: Int) -> BechVariant
    if code == bech32_core.variant_bech32m()
        return Bech32m
    Bech32

// ── Sizing ──────────────────────────────────────────────────────────

// How many characters a string with an `hrp_len`-byte prefix and
// `data_len` five-bit values comes to.
//
// `hrp_len + 1 + data_len + 6`: the prefix, the separator, the data and
// the checksum.  A caller sizing the destination for `encode_into` asks
// this first.
//
// ```novo
// use bech32
//
// fn main() [io]
//     // "bc" plus a version-0 witness program of twenty bytes.
//     println("${bech32.encoded_len(2, 33)}")   // 42
// ```
pub fn encoded_len(hrp_len: Int, data_len: Int) -> Int
    hrp_len + 1 + data_len + bech32_core.checksum_len()

// The offset of the last `1` in `s`, or -1 when there is none.
@tier(app)
fn last_separator(s: Str) -> Int
    var i = str.len(s) - 1
    while i >= 0
        if str.byte_at_or(s, i, 0) == bech32_core.separator()
            return i
        i = i - 1
    -1

// How many five-bit values `s` decodes to, without decoding it.
//
// Reads the length and the separator's position and nothing else, so it
// answers `Ok` for a string whose characters turn out to be invalid.  A
// caller sizing a destination wants the number, and a caller validating
// wants `decode_into`.
pub @tier(app)
fn decoded_len(s: Str) -> Result<Int, BechError>
    let sep = last_separator(s)
    if sep < 0
        return Err(BechNoSeparator)
    if sep == 0
        return Err(BechHrpEmpty)
    let tail = str.len(s) - sep - 1
    if tail < bech32_core.checksum_len()
        return Err(BechDataTooShort(tail))
    Ok(tail - bech32_core.checksum_len())

// ── Encoding ────────────────────────────────────────────────────────

// True when `ch` is an ASCII upper-case letter.
fn is_upper(ch: Int) -> Bool
    ch >= 'A' and ch <= 'Z'

// True when `ch` is an ASCII lower-case letter.
fn is_lower(ch: Int) -> Bool
    ch >= 'a' and ch <= 'z'

// `ch` with an ASCII upper-case letter lowered.
fn lower(ch: Int) -> Int
    if is_upper(ch)
        return ch + 32
    ch

// The checksum state after the expanded prefix `hrp`, read in lower
// case.
fn feed_hrp(hrp: Str) -> BechChk
    let n = str.len(hrp)
    var c = bech32_core.start()
    for i in 0..n
        c = bech32_core.feed(c, bech32_core.hrp_high(lower(str.byte_at_or(hrp, i, 0))))
    c = bech32_core.feed(c, 0)
    for i in 0..n
        c = bech32_core.feed(c, bech32_core.hrp_low(lower(str.byte_at_or(hrp, i, 0))))
    c

// The first reason `hrp` and `data` cannot be encoded, or `None`.
@tier(app)
fn encode_fault(hrp: Str, data: [u8], limited: Bool) -> ?BechError
    let n = str.len(hrp)
    if n == 0
        return Some(BechHrpEmpty)
    let total = encoded_len(n, data.len())
    if limited and total > bech32_core.max_length()
        return Some(BechTooLong(total))
    for i in 0..n
        let ch = str.byte_at_or(hrp, i, 0)
        if ch < 33 or ch > 126
            return Some(BechHrpBadCharacter(i, ch))
    for i in 0..data.len()
        let v = data[i] as Int
        if v > 31
            return Some(BechValueOutOfRange(i, v))
    None

// The ASCII bytes of the encoded string, which `encode_fault` has
// already accepted.
@tier(app)
fn encode_bytes(hrp: Str, data: [u8], v: BechVariant) -> Bytes
    let n = str.len(hrp)
    var out = bytes.zeros(encoded_len(n, data.len()))
    for i in 0..n
        out = bytes.set_u8(out, i, lower(str.byte_at_or(hrp, i, 0)))
    out = bytes.set_u8(out, n, bech32_core.separator())
    var c = feed_hrp(hrp)
    var w = n + 1
    for i in 0..data.len()
        let d = data[i] as Int
        c = bech32_core.feed(c, d)
        out = bytes.set_u8(out, w, bech32_core.charset_at(d))
        w = w + 1
    let done = bech32_core.finish(c, variant_code(v))
    for k in 0..bech32_core.checksum_len()
        out = bytes.set_u8(out, w, bech32_core.charset_at(bech32_core.checksum_value(done, k)))
        w = w + 1
    out

// Encode `hrp` and `data` as a bech32 string.
//
// `data` is five-bit values, `0 ..= 31` each, and `bytes_to_data` turns
// a payload into them.  `hrp` is lower-cased on the way in, so a caller
// that passed `"BC"` gets `"bc1…"` and not a mixed-case string that
// would not decode.
//
// Refuses a result longer than 90 characters; `encode_unlimited` does
// not.
//
// ```novo
// use bech32
//
// fn main() [io]
//     match bech32.encode("a", [], Bech32)
//         Ok(s)  => println(s)   // a12uel5l
//         Err(e) => println(e.message())
// ```
pub @tier(app)
fn encode(hrp: Str, data: [u8], v: BechVariant) -> Result<Str, BechError>
    match encode_fault(hrp, data, true)
        Some(e) => Err(e)
        None    => Ok(bytes.to_str(encode_bytes(hrp, data, v)))

// The same, with the 90-character limit not enforced.
//
// For BOLT 11 lightning invoices and other uses that lift the limit.
// Past 90 characters BIP 173's guarantee that up to four character
// errors are detected no longer holds.
pub @tier(app)
fn encode_unlimited(hrp: Str, data: [u8], v: BechVariant) -> Result<Str, BechError>
    match encode_fault(hrp, data, false)
        Some(e) => Err(e)
        None    => Ok(bytes.to_str(encode_bytes(hrp, data, v)))

// Encode into a buffer the caller already owns, and answer the
// characters written.
//
// `BechBufferTooSmall` when the cursor has less room than `encoded_len`
// says.  Nothing is written for that refusal or any other, because a
// partially encoded buffer looks like an address.
//
// The 90-character limit applies, as it does to `encode`.
pub @tier(app)
fn encode_into(hrp: Str, data: [u8], v: BechVariant, var dst: Cursor) -> Result<Int, BechError>
    match encode_fault(hrp, data, true)
        Some(e) => Err(e)
        None    =>
            let need = encoded_len(str.len(hrp), data.len())
            let have = dst.remaining()
            if need > have
                return Err(BechBufferTooSmall(need, have))
            let out = encode_bytes(hrp, data, v)
            for i in 0..need
                dst.put_u8(bytes.byte_at(out, i) ?? 0)
            Ok(need)

// ── Decoding ────────────────────────────────────────────────────────

// The offset of the first character whose case disagrees with the
// first cased character, or -1.
fn mixed_case_at(s: Str) -> Int
    var seen_upper = false
    var seen_lower = false
    for i in 0..str.len(s)
        let ch = str.byte_at_or(s, i, 0)
        if is_upper(ch)
            if seen_lower
                return i
            seen_upper = true
        if is_lower(ch)
            if seen_upper
                return i
            seen_lower = true
    -1

// Every whole-string and per-character rule, and the checksum, without
// writing anything.  The answer is the separator's offset and the
// variant code.
@tier(app)
fn check(s: Str, limited: Bool) -> Result<(Int, Int), BechError>
    let at = mixed_case_at(s)
    if at >= 0
        return Err(BechMixedCase(at))
    let n = str.len(s)
    if limited and n > bech32_core.max_length()
        return Err(BechTooLong(n))
    let sep = last_separator(s)
    if sep < 0
        return Err(BechNoSeparator)
    if sep == 0
        return Err(BechHrpEmpty)
    if limited and sep > bech32_core.max_length() - 1 - bech32_core.checksum_len()
        return Err(BechHrpTooLong(sep))
    let tail = n - sep - 1
    if tail < bech32_core.checksum_len()
        return Err(BechDataTooShort(tail))
    for i in 0..sep
        let ch = str.byte_at_or(s, i, 0)
        if ch < 33 or ch > 126
            return Err(BechHrpBadCharacter(i, ch))
    var c = feed_hrp(str.slice(s, 0, sep))
    for i in sep + 1..n
        let ch = str.byte_at_or(s, i, 0)
        let v = bech32_core.charset_index(ch)
        if v < 0
            return Err(BechBadCharacter(i, ch))
        c = bech32_core.feed(c, v)
    let found = bech32_core.variant_of(bech32_core.residue(c))
    if found < 0
        return Err(BechBadChecksum(bech32_core.residue(c)))
    Ok((sep, found))

// The shared body of `decode_into` and `decode_unlimited`.
@tier(app)
fn decode_to(s: Str, limited: Bool, var dst: Cursor) -> Result<BechRead, BechError>
    let (sep, found) = check(s, limited)!
    let values = str.len(s) - sep - 1 - bech32_core.checksum_len()
    let have = dst.remaining()
    if values > have
        return Err(BechBufferTooSmall(values, have))
    for i in sep + 1..sep + 1 + values
        dst.put_u8(bech32_core.charset_index(str.byte_at_or(s, i, 0)))
    Ok(BechRead { hrp_start: 0, hrp_end: sep, values: values, variant: found })

// Decode `s` into a buffer the caller already owns.
//
// Answers the human-readable part as a range into `s`, the number of
// five-bit values written, and which variant the checksum named (see
// `BechRead`).  The six checksum values are not written.
//
// The rules are checked in this order: the case mixture, the length,
// the separator's position, the prefix's characters, the data's
// characters, then the checksum.  The earliest refusal is answered, so
// an offset in the error is the leftmost fault of its kind.  Nothing is
// written unless the whole string is valid and the destination has
// room.
//
// ```novo
// use std.bytes
// use bech32
//
// fn main() [io]
//     var buf = bytes.cursor_be(bytes.zeros(64))
//     match bech32.decode_into("a12uel5l", buf)
//         Ok(r)  => println("${r.hrp_start} ${r.hrp_end} ${r.values}")   // 0 1 0
//         Err(e) => println(e.message())
// ```
pub @tier(app)
fn decode_into(s: Str, var dst: Cursor) -> Result<BechRead, BechError>
    decode_to(s, true, var dst)

// The same, with the 90-character limit not enforced.
pub @tier(app)
fn decode_unlimited(s: Str, var dst: Cursor) -> Result<BechRead, BechError>
    decode_to(s, false, var dst)

// Decode `s` into a fresh prefix and a fresh list of values.
//
// The convenience for a host that does not mind allocating, under the
// same rules and refusals as `decode_into`.  The prefix comes back in
// lower case.
//
// ```novo
// use bech32
//
// fn main() [io]
//     match bech32.decode("abcdef1qpzry9x8gf2tvdw0s3jn54khce6mua7lmqqqxw")
//         Ok(d)  => println("${d.hrp} ${d.data.len()}")   // abcdef 32
//         Err(e) => println(e.message())
// ```
pub @tier(app)
fn decode(s: Str) -> Result<BechData, BechError>
    let (sep, found) = check(s, true)!
    let values = str.len(s) - sep - 1 - bech32_core.checksum_len()
    var data: [u8] = []
    for i in sep + 1..sep + 1 + values
        list.push(data, bech32_core.charset_index(str.byte_at_or(s, i, 0)) as u8)
    Ok(BechData { hrp: str.lower(str.slice(s, 0, sep)), data: data,
                  variant: variant_from_code(found) })

// Decode `s` and refuse it unless the checksum names `want`.
//
// `BechWrongVariant` when the string is valid for the other variant,
// which is a different refusal from a bad checksum.
pub @tier(app)
fn decode_variant(s: Str, want: BechVariant) -> Result<BechData, BechError>
    let d = decode(s)!
    let found = variant_code(d.variant)
    if found != variant_code(want)
        return Err(BechWrongVariant(found, variant_code(want)))
    Ok(d)

// True when `s` decodes under either variant.
pub @tier(app)
fn is_valid(s: Str) -> Bool
    match check(s, true)
        Ok(_)  => true
        Err(_) => false

// ── The payload conversion ──────────────────────────────────────────

// `b` regrouped from eight-bit bytes into five-bit values, padded.
//
// Cannot fail, because every byte sequence has a five-bit regrouping.
// A caller does this to a payload before `encode`.
//
// ```novo
// use std.bytes
// use bech32
//
// fn main() [io]
//     let one = bytes.from_hex("ff") ?? bytes.zeros(0)
//     // Eight bits regroup into two five-bit values, the second padded.
//     println("${bech32.bytes_to_data(one).len()}")   // 2
// ```
pub @tier(app)
fn bytes_to_data(b: Bytes) -> [u8]
    var out: [u8] = []
    var c = bechbits.to5()
    for i in 0..bytes.len(b)
        let step = bechbits.feed(c, (bytes.byte_at(b, i) ?? 0) as u8)
        c = step.conv
        for k in 0..step.len
            list.push(out, step.out[k])
    let last = bechbits.finish_padded(c)
    for k in 0..last.len
        list.push(out, last.out[k])
    out

// `data` regrouped from five-bit values back into bytes.
//
// `BechValueOutOfRange` names the first value above 31, and
// `BechBadPadding` is the answer when the tail is five bits or longer
// or has any bit set.
pub @tier(app)
fn data_to_bytes(data: [u8]) -> Result<Bytes, BechError>
    for i in 0..data.len()
        let v = data[i] as Int
        if v > 31
            return Err(BechValueOutOfRange(i, v))
    var out = bytes.zeros(bechbits.out_len(data.len(), 5, 8, false))
    var w = 0
    var c = bechbits.to8()
    for i in 0..data.len()
        let step = bechbits.feed(c, data[i])
        c = step.conv
        for k in 0..step.len
            out = bytes.set_u8(out, w, step.out[k] as Int)
            w = w + 1
    if not bechbits.finish_exact(c).ok
        return Err(BechBadPadding)
    Ok(out)
