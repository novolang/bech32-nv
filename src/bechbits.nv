// bechbits — the eight-to-five bit regrouping, and back, as a state
// machine that allocates nothing and builds for a microcontroller.
//
// bech32 encodes five bits per character and a payload is bytes, so
// every encoder regroups eight-bit groups into five-bit ones and every
// decoder does the reverse.  BIP 173 calls the function `convertbits`
// and gives it a padding flag.  This module is that function as a value
// the caller drives, so a device can run it over a stream it never
// holds whole.
//
// The two directions end differently.
//
// - Eight to five pads.  The leftover bits at the end are padded with
//   zeros up to a whole five-bit group and emitted, so a payload of any
//   length has an encoding.
// - Five to eight does not pad.  The leftover bits at the end must be
//   fewer than five and must all be zero, and they are discarded.  BIP
//   173 requires both; its invalid vectors "zero padding of more than 4
//   bits" and "non-zero padding in 8-to-5 conversion" test them.  A
//   decoder that accepted either would let two different strings decode
//   to the same bytes.
//
// `finish_padded` and `finish_exact` are those two rules, named.
//
// One step emits at most two values.  From eight bits to five, the
// accumulator holds at most four bits before a byte arrives, so twelve
// bits are available and two groups of five come out.  From five to
// eight it holds at most seven, so twelve again and one byte comes out.
// The emit buffer is therefore a fixed `[u8; 2]` and not a list.
//
// Every function here carries `@tier(embedded)`.

// A partial group, mid-regrouping: the bits that have arrived and have
// not yet been emitted.
//
// A `@value` struct, so it lives in the caller's stack frame with no
// header, no reference count and no allocation.
//
// `acc` holds the pending bits right-aligned, `bits` is how many of
// them there are, and `from_bits` and `to_bits` say which direction
// this converter runs in.  The direction is carried on the value rather
// than chosen by each call, so one converter cannot be fed in both
// directions.
pub @value
struct BechConv
    acc: Int
    bits: Int
    from_bits: Int
    to_bits: Int

// What one step produced: the converter after it, the values to write,
// and whether the step was sound.
//
// `out` is a fixed two-element inline array because two is the most any
// step can produce, and `len` says how many of the two are written.
// `ok` is false only from `finish_exact`, and only for a tail that
// should not have been there.
pub @value
struct BechConvStep
    conv: BechConv
    out: [u8; 2]
    len: Int
    ok: Bool

// A converter that takes eight-bit bytes and emits five-bit values.
//
// The encode direction.  Close it with `finish_padded`.
//
// ```novo
// use bechbits
//
// fn main() [io]
//     println("${bechbits.to5().to_bits}")   // 5
// ```
pub @tier(embedded)
fn to5() -> BechConv
    BechConv { acc: 0, bits: 0, from_bits: 8, to_bits: 5 }

// A converter that takes five-bit values and emits eight-bit bytes.
//
// The decode direction.  Close it with `finish_exact`.
pub @tier(embedded)
fn to8() -> BechConv
    BechConv { acc: 0, bits: 0, from_bits: 5, to_bits: 8 }

// The low `n` bits set: 31 for five and 255 for eight.
@tier(embedded)
fn mask(n: Int) -> Int
    (1 << n) - 1

// Feed one value and answer the converter after it with what to write.
//
// Bits of `v` above `from_bits` are masked off rather than refused.  A
// charset index is `0 ..= 31` and a byte is `0 ..= 255`, and each is
// checked where it is read.
//
// ```novo
// use bechbits
//
// fn main() [io]
//     // One byte in: three bits held back, one five-bit value out.
//     let step = bechbits.feed(bechbits.to5(), 255 as u8)
//     println("${step.len} ${step.conv.bits}")   // 1 3
// ```
pub @tier(embedded)
fn feed(c: BechConv, v: u8) -> BechConvStep
    var acc = (c.acc << c.from_bits) | (v as Int & mask(c.from_bits))
    var held = c.bits + c.from_bits
    var first = 0
    var second = 0
    var len = 0
    if held >= c.to_bits
        held = held - c.to_bits
        first = (acc >> held) & mask(c.to_bits)
        len = 1
    if held >= c.to_bits
        held = held - c.to_bits
        second = (acc >> held) & mask(c.to_bits)
        len = 2
    acc = acc & mask(held)
    BechConvStep {
        conv: BechConv { acc: acc, bits: held, from_bits: c.from_bits, to_bits: c.to_bits },
        out: [first as u8, second as u8],
        len: len,
        ok: true }

// Close an eight-to-five conversion: pad the leftover bits with zeros
// and emit them.
//
// `len` is 0 when nothing is pending and 1 otherwise.  It is never 2,
// because fewer than five bits are ever left over.  `ok` is always
// true, because every payload has an encoding.
//
// ```novo
// use bechbits
//
// fn main() [io]
//     let one = bechbits.feed(bechbits.to5(), 255 as u8)
//     println("${bechbits.finish_padded(one.conv).len}")   // 1
// ```
pub @tier(embedded)
fn finish_padded(c: BechConv) -> BechConvStep
    let done = BechConv { acc: 0, bits: 0, from_bits: c.from_bits, to_bits: c.to_bits }
    if c.bits == 0
        return BechConvStep { conv: done, out: [0 as u8, 0 as u8], len: 0, ok: true }
    let last = (c.acc << (c.to_bits - c.bits)) & mask(c.to_bits)
    BechConvStep { conv: done, out: [last as u8, 0 as u8], len: 1, ok: true }

// Close a five-to-eight conversion: check the leftover bits and discard
// them.
//
// `ok` is false when `from_bits` or more bits are left over, which
// means a whole input value was padding, or when any leftover bit is
// set.  BIP 173 requires both.  `len` is 0 either way, because this
// direction emits nothing at the end.
pub @tier(embedded)
fn finish_exact(c: BechConv) -> BechConvStep
    let done = BechConv { acc: 0, bits: 0, from_bits: c.from_bits, to_bits: c.to_bits }
    let sound = c.bits < c.from_bits and (c.acc & mask(c.bits)) == 0
    BechConvStep { conv: done, out: [0 as u8, 0 as u8], len: 0, ok: sound }

// How many values `n` inputs regroup to.
//
// `(n * from_bits + to_bits - 1) / to_bits` when `pad` is true and
// `(n * from_bits) / to_bits` when it is not.  A caller sizing a
// destination asks this before it starts, and `bech32.encoded_len`
// rests on it.
//
// ```novo
// use bechbits
//
// fn main() [io]
//     // Twenty bytes of a version-0 witness program are 32 characters.
//     println("${bechbits.out_len(20, 8, 5, true)}")   // 32
// ```
pub @tier(embedded)
fn out_len(n: Int, from_bits: Int, to_bits: Int, pad: Bool) -> Int
    if pad
        return (n * from_bits + to_bits - 1) / to_bits
    n * from_bits / to_bits
