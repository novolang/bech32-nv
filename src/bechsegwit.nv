// bechsegwit — segwit addresses, the one application of bech32 that
// the specifications themselves define.
//
// bech32 is a general encoding: BOLT 11 invoices, Nostr identifiers and
// several PSBT fields use it, and segwit is one consumer.  This module
// holds everything specific to Bitcoin, so the general half has none.
//
// The witness version chooses the encoding.  Version 0 is bech32, and
// versions 1 through 16 are bech32m (BIP 350 § "Addresses for segregated
// witness outputs").  A version-1 address encoded as bech32 is invalid,
// and so is a version-0 address encoded as bech32m.  `variant_for` is
// that rule as one function, and everything else here calls it.
//
// The program's length is checked against the version.  BIP 141 fixes
// version 0 at exactly 20 bytes (a key hash) or exactly 32 (a script
// hash), and every later version takes 2 to 40 (BIP 173 § "Segwit
// address format").  `check_program` is that rule.
//
// The prefix is the caller's argument, such as `bc`, `tb` or `bcrt`.
// The set of networks is not fixed by the specification, so no list of
// them is kept here.

use std.bytes
use std.str
use bech32
use bech32_core

// A decoded segwit address.
//
// A boxed struct because it is a `Result` payload and owns a `Str` and
// a `Bytes`, neither of which a `@value` may hold.
pub struct BechSegwit
    // The network prefix as it appeared, lower-cased: `bc`, `tb`,
    // `bcrt`.
    hrp: Str
    // The witness version, `0 ..= 16`.
    version: Int
    // The witness program, 2 to 40 bytes.
    program: Bytes

// The encoding a witness version must use: `bech32_core`'s code for
// bech32 at version 0, and for bech32m at 1 and above.
//
// A caller handling addresses itself should call this rather than
// writing `if version == 0` a second time.
//
// ```novo
// use bechsegwit
// use bech32_core
//
// fn main() [io]
//     println("${bechsegwit.variant_for(0) == bech32_core.variant_bech32()}")    // true
//     println("${bechsegwit.variant_for(1) == bech32_core.variant_bech32m()}")   // true
// ```
pub fn variant_for(version: Int) -> Int
    if version == 0
        return bech32_core.variant_bech32()
    bech32_core.variant_bech32m()

// True when `len` is a program length `version` allows.
//
// Version 0: exactly 20 or exactly 32, the key hash and the script hash
// BIP 141 defines.  Versions 1 to 16: 2 through 40.  Any other version:
// false, because there are seventeen.
//
// ```novo
// use bechsegwit
//
// fn main() [io]
//     println("${bechsegwit.check_program(0, 20)}")   // true
//     println("${bechsegwit.check_program(0, 21)}")   // false
//     println("${bechsegwit.check_program(1, 32)}")   // true
// ```
pub fn check_program(version: Int, len: Int) -> Bool
    if version == 0
        return len == 20 or len == 32
    if version < 0 or version > 16
        return false
    len >= 2 and len <= 40

// How many characters the address for a program of `program_len` bytes
// under an `hrp_len`-byte prefix comes to.
//
// The version is one five-bit value and the program regroups from
// eight bits to five, so this is
// `hrp_len + 1 + 1 + ceil(program_len * 8 / 5) + 6`.
//
// ```novo
// use bechsegwit
//
// fn main() [io]
//     // "bc" and a twenty-byte program: the 42-character version-0
//     // address.
//     println("${bechsegwit.encoded_len(2, 20)}")   // 42
// ```
pub fn encoded_len(hrp_len: Int, program_len: Int) -> Int
    bech32.encoded_len(hrp_len, 1 + (program_len * 8 + 4) / 5)

// The version and the program as bech32 data values, after checking
// that the pair is an address.
@tier(app)
fn address_data(version: Int, program: Bytes) -> Result<[u8], BechError>
    if version < 0 or version > 16
        return Err(BechBadVersion(version))
    if not check_program(version, bytes.len(program))
        return Err(BechBadProgramLength(version, bytes.len(program)))
    var data: [u8] = [version as u8]
    for v in bech32.bytes_to_data(program)
        list.push(data, v)
    Ok(data)

// The address for `version` and `program` under `hrp`.
//
// The encoding is chosen by `variant_for` and is not the caller's to
// choose.  Refuses a version outside `0 ..= 16` and a program length
// `check_program` rejects.
//
// ```novo
// use std.bytes
// use bechsegwit
//
// fn main() [io]
//     let prog = bytes.from_hex("751e76e8199196d454941c45d1b3a323f1433bd6") ?? bytes.zeros(0)
//     match bechsegwit.encode("bc", 0, prog)
//         Ok(a)  => println(a)
//         Err(e) => println(e.message())
//     // bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4
// ```
pub @tier(app)
fn encode(hrp: Str, version: Int, program: Bytes) -> Result<Str, BechError>
    let data = address_data(version, program)!
    bech32.encode(hrp, data, bech32.variant_from_code(variant_for(version)))

// The address, written into a buffer the caller already owns.
//
// `BechBufferTooSmall` when the cursor has less room than `encoded_len`
// says, and nothing is written in that case.
pub @tier(app)
fn encode_into(hrp: Str, version: Int, program: Bytes, var dst: Cursor) -> Result<Int, BechError>
    let data = address_data(version, program)!
    bech32.encode_into(hrp, data, bech32.variant_from_code(variant_for(version)), dst)

// The network, version and program `s` names.
//
// Every bech32 refusal, then this module's own, in the order of BIP
// 350's reference decoder: an empty data part (`BechNoWitnessVersion`),
// padding the regrouping refuses (`BechBadPadding`), a program outside
// 2 to 40 bytes (`BechBadProgramLength`), a version outside `0 ..= 16`
// (`BechBadVersion`), a version-0 program that is not 20 or 32 bytes
// (`BechBadProgramLength`), and last a checksum of the variant the
// version does not use (`BechWrongVariant`).
//
// The prefix is not checked against a list of networks.  It comes back
// as it was, lower-cased, and `decode_for` compares it with the one a
// caller expects.
//
// ```novo
// use std.bytes
// use bechsegwit
//
// fn main() [io]
//     match bechsegwit.decode("BC1QW508D6QEJXTDG4Y5R3ZARVARY0C5XW7KV8F3T4")
//         Ok(a)  => println("${a.hrp} ${a.version} ${bytes.len(a.program)}")   // bc 0 20
//         Err(e) => println(e.message())
// ```
pub @tier(app)
fn decode(s: Str) -> Result<BechSegwit, BechError>
    let d = bech32.decode(s)!
    if d.data.len() == 0
        return Err(BechNoWitnessVersion)
    let version = d.data[0] as Int
    let program = bech32.data_to_bytes(d.data[1:])!
    let n = bytes.len(program)
    if n < 2 or n > 40
        return Err(BechBadProgramLength(version, n))
    if version > 16
        return Err(BechBadVersion(version))
    if not check_program(version, n)
        return Err(BechBadProgramLength(version, n))
    let found = bech32.variant_code(d.variant)
    if found != variant_for(version)
        return Err(BechWrongVariant(found, variant_for(version)))
    Ok(BechSegwit { hrp: d.hrp, version: version, program: program })

// The same, refused unless the prefix is `hrp`.
//
// For a caller with one network in mind, such as a wallet on the main
// network that should not accept a test-network address.  The
// comparison ignores case, because an address may be printed in upper
// case.
pub @tier(app)
fn decode_for(s: Str, hrp: Str) -> Result<BechSegwit, BechError>
    let a = decode(s)!
    let wanted = str.lower(hrp)
    if a.hrp != wanted
        return Err(BechWrongHrp(a.hrp, wanted))
    Ok(a)

// True when `s` is a segwit address under any prefix.
pub @tier(app)
fn is_address(s: Str) -> Bool
    match decode(s)
        Ok(_)  => true
        Err(_) => false

// The `scriptPubKey` bytes for a version and a program.
//
// `OP_0` for version 0 and `OP_1` through `OP_16`, the bytes 0x51 to
// 0x60, for the rest, then a push of the program (BIP 141 § "Witness
// program").  A caller that has decoded an address usually wants this
// next.
//
// ```novo
// use std.bytes
// use bechsegwit
//
// fn main() [io]
//     let prog = bytes.from_hex("751e76e8199196d454941c45d1b3a323f1433bd6") ?? bytes.zeros(0)
//     match bechsegwit.script_pubkey(0, prog)
//         Ok(b)  => println(bytes.to_hex(b))
//         Err(e) => println(e.message())
//     // 0014751e76e8199196d454941c45d1b3a323f1433bd6
// ```
pub @tier(app)
fn script_pubkey(version: Int, program: Bytes) -> Result<Bytes, BechError>
    if version < 0 or version > 16
        return Err(BechBadVersion(version))
    let n = bytes.len(program)
    if not check_program(version, n)
        return Err(BechBadProgramLength(version, n))
    var out = bytes.zeros(n + 2)
    if version == 0
        out = bytes.set_u8(out, 0, 0)
    else
        out = bytes.set_u8(out, 0, 0x50 + version)
    out = bytes.set_u8(out, 1, n)
    for i in 0..n
        out = bytes.set_u8(out, i + 2, bytes.byte_at(program, i) ?? 0)
    Ok(out)
