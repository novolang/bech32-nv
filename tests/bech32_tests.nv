fn test_every_bip_350_invalid_string_is_refused_for_its_stated_reason()
    assert_refused(led(0x20, "1xj0phk"), "HrpBadCharacter")
    assert_refused(led(0x7f, "1g6xzxy"), "HrpBadCharacter")
    assert_refused(led(0x80, "1vctc34"), "HrpBadCharacter")
    assert_refused("an84characterslonghumanreadablepartthatcontainsthetheexcludedcharactersbioandnumber11d6pts4",
        "TooLong")
