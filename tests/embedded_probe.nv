// tests/embedded_probe.nv — the package's device claim, as a program
// that either builds for a Cortex-M or does not.
//
// The shard audit's `core-embedded` row copies this and the modules its
// `use` lines reach into a package of its own and runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a real Cortex-M4 ELF or fails.  The consumer that
// makes the claim worth having is a HARDWARE WALLET: the device that
// signs a transaction is the device that has to show the address on its
// own screen, because an address shown on the host is an address the
// host could have replaced.  It has no heap and no room for a second
// copy of the string, so the checksum and the regrouping have to run in
// a few registers.
//
// It BUILDS; it does not run.  Every function it calls is a `todo()`
// today, so a device that executed this would panic on the first line
// of `main`.  What is being checked is the tier: `--target=nrf52-qemu`
// stamps `@tier(embedded)` on every function it compiles, so the
// checker walks the module and refuses a `Str` concatenation, a list
// literal or an unbounded `while` wherever the implementation later
// puts one.
//
// `bech32` AND `bechsegwit` ARE NOT USED HERE, and that is the split
// rather than a convenience: they speak `Str`, `Bytes` and `Cursor`,
// the embedded runtime defines none of them, and one host-only function
// anywhere in a compilation unit is an undefined symbol at embedded
// link time whether or not the firmware calls it.

use bech32_core
use bechbits

// Twenty bytes the way firmware holds a witness program.
//
// The array is a FIELD of a `@value` struct rather than a return type,
// because `[u8; 20]` is a true inline array only inside one — outside,
// the annotation still means a list, and a list literal is an implicit
// heap allocation the tier refuses (SPEC § 14.4).
@value
struct ProbeProgram
    b: [u8; 20]

// The first twenty bytes of BIP 173's own worked example, the key hash
// behind `bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4`.
fn probe_program() -> ProbeProgram
    ProbeProgram { b: [0x75 as u8, 0x1e as u8, 0x76 as u8, 0xe8 as u8, 0x19 as u8,
                       0x91 as u8, 0x96 as u8, 0xd4 as u8, 0x54 as u8, 0x94 as u8,
                       0x1c as u8, 0x45 as u8, 0xd1 as u8, 0xb3 as u8, 0xa3 as u8,
                       0x23 as u8, 0xf1 as u8, 0x43 as u8, 0x3b as u8, 0xd6 as u8] }

fn main() [hw]
    // The constants, so a device that sizes a display buffer compiles
    // the same numbers the host does.
    //
    // Each step is bound with its type written out because a call into
    // another module does not have its return type inferred in a
    // single-file build.  Inside a package built as one unit — which is
    // what every host suite does — none of these annotations is needed.
    let v32 = bech32_core.variant_bech32()
    let v32m = bech32_core.variant_bech32m()
    let k32 = bech32_core.variant_const(v32)
    let k32m = bech32_core.variant_const(v32m)
    let sum_len = bech32_core.checksum_len()
    let cap = bech32_core.max_length()
    let sep = bech32_core.separator()

    // The charset, read both ways — what an encoder's and a decoder's
    // inner loops each do before they shift anything.
    let sym = bech32_core.charset_at(0)
    let val = bech32_core.charset_index(113)

    // The checksum over the prefix `bc`, driven exactly as BIP 173's
    // pseudocode drives it: the high bits of every prefix character, a
    // zero, then the low bits.
    var c: BechChk = bech32_core.start()
    c = bech32_core.feed(c, bech32_core.hrp_high(98))
    c = bech32_core.feed(c, bech32_core.hrp_high(99))
    c = bech32_core.feed(c, 0)
    c = bech32_core.feed(c, bech32_core.hrp_low(98))
    c = bech32_core.feed(c, bech32_core.hrp_low(99))

    // The witness version, then the program regrouped eight bits to
    // five and fed straight into the checksum — no intermediate buffer,
    // which is the shape a device with 4 KB of RAM needs.
    c = bech32_core.feed(c, 0)
    let src = probe_program()
    var conv: BechConv = bechbits.to5()
    for i in 0..20
        let step: BechConvStep = bechbits.feed(conv, src.b[i])
        conv = step.conv
        for k in 0..step.len
            let out: u8 = step.out[k]
            c = bech32_core.feed(c, out as Int)
            // A real wallet would put this character on its screen;
            // here the write is what forces the loop to be compiled.
            hal.uart.write(".")

    let tail: BechConvStep = bechbits.finish_padded(conv)
    for k in 0..tail.len
        let out: u8 = tail.out[k]
        c = bech32_core.feed(c, out as Int)
        hal.uart.write("-")

    // Close it and read the six checksum characters out.
    let done: BechChk = bech32_core.finish(c, v32)
    for i in 0..6
        let cv = bech32_core.checksum_value(done, i)
        let ch = bech32_core.charset_at(cv)
        hal.uart.write("=")

    // And the verify direction, which is what a wallet checking an
    // address the host sent it actually runs.
    let res = bech32_core.residue(done)
    let which = bech32_core.variant_of(res)
    if bech32_core.verify(done, v32) and which == v32
        hal.uart.write("!")

    // The decode-side regrouping, five bits back to eight, with the
    // exact tail rule that refuses a non-canonical string.
    var back: BechConv = bechbits.to8()
    for i in 0..32
        let step: BechConvStep = bechbits.feed(back, 0 as u8)
        back = step.conv
        for k in 0..step.len
            let b: u8 = step.out[k]
            hal.uart.write("+")

    let rest: BechConvStep = bechbits.finish_exact(back)
    let room = bechbits.out_len(20, 8, 5, true)
    if rest.ok and room + sym + val + k32 + k32m + sum_len + cap + sep > 0
        hal.uart.write("?")

    hal.uart.write("bech32-nv: five bits at a time\n")
