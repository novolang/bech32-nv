// tests/embedded_probe.nv — `bech32_core` and `bechbits` on a
// microcontroller, as a program that builds for a Cortex-M, boots there
// and checks its answers.
//
// This file and the modules its `use` lines reach are built with
//
//   novo build --target=nrf52-qemu tests/embedded_probe.nv
//
// which produces a Cortex-M4 ELF or fails.  The same ELF boots under
//
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting -kernel probe.elf
//
// and writes `ok` for each of the five things it checks.  The build
// checks something the run cannot: `--target=nrf52-qemu` stamps
// `@tier(embedded)` on every function it compiles, so a `Str`
// concatenation, a list literal or an unbounded `while` is refused
// wherever it is written.
//
// A hardware wallet is the device this is for.  The device that signs a
// transaction has to show the address on its own screen, because an
// address shown by the host is one the host could have replaced.
//
// The answers are compared against integer literals and printed as
// `ok`.  Turning a byte into text is `str.from_byte`, which is
// host-only.
//
// The `bech32` and `bechsegwit` modules are not used here.  They speak
// `Str`, `Bytes` and `Cursor`, the embedded runtime defines none of
// them, and one host-only function anywhere in a compilation unit is an
// undefined symbol at link time whether or not the firmware calls it.

use bech32_core
use bechbits

// The witness program of BIP 173's worked example,
// `bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4`, held the way firmware
// holds it.
//
// The array is a field of a `@value` struct because `[u8; 20]` is a true
// inline array only inside one.  Outside, the annotation still means a
// list, and a list literal is a heap allocation a device build refuses
// (SPEC § 14.4).
@value
struct ProbeProgram
    b: [u8; 20]

fn probe_program() -> ProbeProgram
    ProbeProgram { b: [117 as u8, 30 as u8, 118 as u8, 232 as u8, 25 as u8, 145 as u8, 150 as u8, 212 as u8,
                    84 as u8, 148 as u8, 28 as u8, 69 as u8, 209 as u8, 179 as u8, 163 as u8, 35 as u8,
                    241 as u8, 67 as u8, 59 as u8, 214 as u8] }

// The thirty-two data characters after the version `q`, and the six
// checksum characters, as ASCII bytes.
@value
struct ProbeText
    data: [u8; 32]
    sum: [u8; 6]

fn probe_text() -> ProbeText
    ProbeText { data: [119 as u8, 53 as u8, 48 as u8, 56 as u8, 100 as u8, 54 as u8, 113 as u8, 101 as u8,
                    106 as u8, 120 as u8, 116 as u8, 100 as u8, 103 as u8, 52 as u8, 121 as u8, 53 as u8,
                    114 as u8, 51 as u8, 122 as u8, 97 as u8, 114 as u8, 118 as u8, 97 as u8, 114 as u8,
                    121 as u8, 48 as u8, 99 as u8, 53 as u8, 120 as u8, 119 as u8, 55 as u8, 107 as u8],
                sum: [118 as u8, 56 as u8, 102 as u8, 51 as u8, 116 as u8, 52 as u8] }

fn say(label: Str, good: Bool) [hw]
    hal.uart.write(label)
    if good
        hal.uart.write(": ok\n")
    else
        hal.uart.write(": BAD\n")

fn main() [hw]
    // The constants, so a device that sizes a display buffer compiles
    // the same numbers the host does.
    let v32 = bech32_core.variant_bech32()
    var good = bech32_core.variant_const(v32) == 1
    good = good and bech32_core.variant_const(bech32_core.variant_bech32m()) == 0x2bc830a3
    good = good and bech32_core.checksum_len() == 6 and bech32_core.max_length() == 90
    good = good and bech32_core.separator() == 49
    good = good and bechbits.out_len(20, 8, 5, true) == 32
    say("constants", good)

    // The charset, read both ways.
    good = bech32_core.charset_at(0) == 113 and bech32_core.charset_index(81) == 0
    good = good and bech32_core.charset_index(98) == -1
    say("charset", good)

    // The checksum over the prefix `bc`, driven as BIP 173's pseudocode
    // drives it: the high bits of every prefix character, a zero, then
    // the low bits.  Then the version, then the program regrouped from
    // eight bits to five and fed straight into the checksum with no
    // intermediate buffer.
    //
    // Each step is bound with its type written out because a call into
    // another module does not have its return type inferred in a
    // single-file build.
    let src = probe_program()
    let want = probe_text()
    var c: BechChk = bech32_core.start()
    c = bech32_core.feed(c, bech32_core.hrp_high(98))
    c = bech32_core.feed(c, bech32_core.hrp_high(99))
    c = bech32_core.feed(c, 0)
    c = bech32_core.feed(c, bech32_core.hrp_low(98))
    c = bech32_core.feed(c, bech32_core.hrp_low(99))
    c = bech32_core.feed(c, 0)
    var written = 0
    good = true
    var conv: BechConv = bechbits.to5()
    for i in 0..20
        let step: BechConvStep = bechbits.feed(conv, src.b[i])
        conv = step.conv
        for k in 0..step.len
            let out: u8 = step.out[k]
            c = bech32_core.feed(c, out as Int)
            if bech32_core.charset_at(out as Int) != (want.data[written] as Int)
                good = false
            written = written + 1
    let tail: BechConvStep = bechbits.finish_padded(conv)
    good = good and tail.len == 0 and written == 32
    say("data", good)

    // Close it and compare the six checksum characters.
    let done: BechChk = bech32_core.finish(c, v32)
    good = true
    for i in 0..6
        if bech32_core.charset_at(bech32_core.checksum_value(done, i)) != (want.sum[i] as Int)
            good = false
    say("checksum", good)

    // The verify direction and the five-to-eight regrouping, which is
    // what a wallet checking an address the host sent it runs.
    var v: BechChk = bech32_core.start()
    v = bech32_core.feed(v, bech32_core.hrp_high(98))
    v = bech32_core.feed(v, bech32_core.hrp_high(99))
    v = bech32_core.feed(v, 0)
    v = bech32_core.feed(v, bech32_core.hrp_low(98))
    v = bech32_core.feed(v, bech32_core.hrp_low(99))
    v = bech32_core.feed(v, 0)
    var back: BechConv = bechbits.to8()
    var read = 0
    good = true
    for i in 0..32
        let value = bech32_core.charset_index(want.data[i] as Int)
        v = bech32_core.feed(v, value)
        let step: BechConvStep = bechbits.feed(back, value as u8)
        back = step.conv
        for k in 0..step.len
            let b: u8 = step.out[k]
            if b != src.b[read]
                good = false
            read = read + 1
    for i in 0..6
        v = bech32_core.feed(v, bech32_core.charset_index(want.sum[i] as Int))
    let rest: BechConvStep = bechbits.finish_exact(back)
    good = good and rest.ok and read == 20 and bech32_core.verify(v, v32)
    good = good and bech32_core.variant_of(bech32_core.residue(v)) == v32
    say("verify", good)

    hal.uart.write("bech32-nv: five bits at a time\n")
